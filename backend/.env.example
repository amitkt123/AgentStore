# Copy to backend/.env (git-ignored). Read by the `dev` profile; see application-dev.yml.
DB_PORT=5433
DB_PASSWORD=agentstore
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef-0123456789
EMAIL_MODE=log
WEB_BASE_URL=http://localhost:3000
ADMIN_EMAILS=
# Runner (only needed for builds and runs)
RUNNER_BASE_URL=http://localhost:8090
RUNNER_SECRET=dev-runner-secret
# LLM keys (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Payouts (RazorpayX); only for the razorpayx provider, dev uses the fake one
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
