{
  "name": "agentstore-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line client for the AgentStore developer API",
  "type": "module",
  "bin": {
    "agentstore": "dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-schema": "node scripts/sync-schema.mjs",
    "build": "npm run sync-schema && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "ignore": "^7.0.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
