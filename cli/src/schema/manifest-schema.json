{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentManifest",
  "type": "object",
  "required": ["name", "version", "scopes", "network", "costEnvelope", "approvalGates", "dataClasses"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1, "maxLength": 50 },
    "runtime": { "type": "string", "enum": ["python-3.12", "node-22"] },
    "entrypoint": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$" },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "resource", "description"],
        "properties": {
          "type": { "type": "string", "enum": ["READ", "WRITE"] },
          "resource": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "requiresApproval": { "type": "boolean" }
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["allowlist"],
      "properties": {
        "allowlist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "costEnvelope": {
      "type": "object",
      "required": ["currency", "maxPerRun", "pricingUnit", "unitPrice", "unitLabel"],
      "properties": {
        "currency": { "type": "string" },
        "maxPerRun": { "type": "number", "minimum": 0 },
        "pricingUnit": { "type": "string", "enum": ["METERED", "OUTCOME", "SUBSCRIPTION"] },
        "unitPrice": { "type": "number", "minimum": 0 },
        "unitLabel": { "type": "string", "minLength": 1 }
      }
    },
    "modelRequirements": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "approvalGates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "description"],
        "properties": {
          "trigger": { "type": "string", "maxLength": 100 },
          "description": { "type": "string" },
          "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
        }
      }
    },
    "dataClasses": { "type": "array", "items": { "type": "string" } },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "format"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]{0,99}$" },
          "format": { "type": "string", "enum": ["csv", "json", "pdf"] },
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "date"] }
                  }
                }
              }
            }
          }
        },
        "if": { "properties": { "format": { "const": "pdf" } }, "required": ["format"] },
        "then": { "not": { "required": ["schema"] } }
      }
    }
  }
}
