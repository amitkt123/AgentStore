{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentManifest",
  "type": "object",
  "required": ["name", "version", "scopes", "network", "costEnvelope", "approvalGates", "dataClasses"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1, "maxLength": 50 },
    "runtime": { "type": "string", "enum": ["python-3.12", "node-22"] },
    "entrypoint": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$" },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "resource", "description"],
        "properties": {
          "type": { "type": "string", "enum": ["READ", "WRITE"] },
          "resource": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["allowlist"],
      "properties": {
        "allowlist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "costEnvelope": {
      "type": "object",
      "required": ["currency", "maxPerRun", "pricingUnit", "unitPrice", "unitLabel"],
      "properties": {
        "currency": { "type": "string" },
        "maxPerRun": { "type": "number", "minimum": 0 },
        "pricingUnit": { "type": "string", "enum": ["METERED", "OUTCOME", "SUBSCRIPTION"] },
        "unitPrice": { "type": "number", "minimum": 0 },
        "unitLabel": { "type": "string", "minLength": 1 }
      }
    },
    "modelRequirements": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "approvalGates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "description"],
        "properties": {
          "trigger": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "dataClasses": { "type": "array", "items": { "type": "string" } }
  }
}
